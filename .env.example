# Eurostat CLI — configuration template
#
# Copy to ~/.env and fill in values for the features you use:
#   cp .env.example ~/.env && chmod 600 ~/.env
#
# Never commit ~/.env. Use LF line endings (not Windows CRLF).
# Full reference: docs/CONFIGURATION.md

# ── Object storage (S3-compatible) ──────────────────────────────────────────
# Required for: ./scripts/sync-s3.sh , eurostat mirror s3
S3_EUROSTAT_BUCKET=eurostat
S3_EUROSTAT_ENDPOINT=
S3_EUROSTAT_REGION=fsn1
S3_EUROSTAT_ACCESS_KEY=
S3_EUROSTAT_SECRET_KEY=

# Optional: parallel fetch / upload workers
EUROSTAT_PARALLEL=16

# ── ClickHouse (optional analytics pipeline) ───────────────────────────────
# Required for: ./scripts/clickhouse-ingest.sh , eurostat clickhouse …
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=eurostat
CLICKHOUSE_INGEST_PARALLEL=4

# Remote ClickHouse: set CLICKHOUSE_TLS=1 and usually:
#   CLICKHOUSE_HTTP_PORT=8443
#   CLICKHOUSE_PORT=9440
CLICKHOUSE_TLS=0

# ── Optional paths ─────────────────────────────────────────────────────────
# EUROSTAT_DATA_DIR=~/.local/share/eurostat
# Server / daemon installs often use:
# EUROSTAT_DATA_DIR=/var/lib/eurostat
# EUROSTAT_LOG_DIR=/var/log/eurostat
# EUROSTAT_BIN=/home/you/eurostat/target/release/eurostat
